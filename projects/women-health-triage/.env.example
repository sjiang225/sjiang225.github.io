OPENAI_API_KEY=your-openai-api-key

# Optional Streamlit scheduling configuration
DOCTOR_SCHEDULE_PATH=uploaded_schedule.xlsx
APPOINTMENTS_DB=appointments.sqlite3
CLINIC_DAY_START=09:00
CLINIC_DAY_END=17:00

# Optional Twilio voice interface configuration
VOICE_PORT=5050
PUBLIC_BASE_URL=https://your-ngrok-or-domain.example.com
CLINIC_NAME=Women's Health Clinic
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=verse
OPENAI_REALTIME_TEMPERATURE=0.7
